---
import { formatDate, formatPercent } from "@/lib/format";
import { positionResult, type PositionResultInput } from "@/lib/result";

type Props = PositionResultInput;

const { buy_price, quantity, current_price, price_date } = Astro.props;
const result = positionResult({ buy_price, quantity, current_price, price_date });

// Percent only, by the author's decision (2026-10-15); `result.amount` is computed but not shown.
---

{result ? (
  <span class="tabular-nums">
    <span class="font-semibold">{formatPercent(result.percent)}</span>
    <span class="text-muted-foreground"> as of {formatDate(result.priceDate)}</span>
  </span>
) : (
  <span class="text-muted-foreground">No price yet</span>
)}
