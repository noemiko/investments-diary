---
import { Minus, TrendingDown, TrendingUp } from "lucide-react";
import { describeResult, NO_PRICE, type PositionResultInput } from "@/lib/result";

type Props = PositionResultInput;

const { buy_price, quantity, current_price, price_date, sell_price, sell_date } = Astro.props;
const result = describeResult({ buy_price, quantity, current_price, price_date, sell_price, sell_date });

// Percent only, by the author's decision (2026-10-15); `positionResult().amount` is computed but not shown.
// The icon is a neutral, decorative direction cue in the foreground colour: the sign in the text still
// carries the direction for screen readers, and results get no gain/loss colour (no verdict).
const Icon = result ? { up: TrendingUp, down: TrendingDown, flat: Minus }[result.direction] : null;
---

{result && Icon ? (
  <span class="tabular-nums" data-result-direction={result.direction}>
    <Icon aria-hidden="true" className="inline size-[1.1em] align-[-0.2em] text-foreground" />
    <span class="text-[1.05em] font-semibold">{result.percent}</span>
    <span class="text-muted-foreground"> {result.asOf}</span>
  </span>
) : (
  <span class="text-muted-foreground">{NO_PRICE}</span>
)}
