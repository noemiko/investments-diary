---
import DeletePositionControl from "@/components/positions/DeletePositionControl.astro";
import { Badge } from "@/components/ui/badge";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import PositionResult from "@/components/positions/PositionResult.astro";
import PriceContext from "@/components/market-prices/PriceContext.astro";
import { formatDate, formatNumber } from "@/lib/format";
import type { PositionListItem } from "@/types";

interface Props {
  kind: "open" | "closed";
  positions: PositionListItem[];
  showWallet: boolean;
}

const { kind, positions, showWallet } = Astro.props;
const closed = kind === "closed";
const title = closed ? "Closed positions" : "Open positions";
// Keyed by the first row, so a page rendering several lists (the kitchen sink) keeps ids unique.
const headingId = `${kind}-positions-${positions[0]?.id ?? "empty"}`;

// Below `md` the rows render as cards. The two markups duplicate content, so one is always
// `display: none` (out of the accessibility tree); the <tr> stays the element tests and smoke target.
---

<section aria-labelledby={headingId} class="flex min-w-0 flex-col gap-3" data-positions-section={kind}>
  <div class="flex items-baseline gap-2">
    <h2 id={headingId} class="text-lg font-semibold">
      {title}
    </h2>
    <span class="text-sm text-muted-foreground tabular-nums" data-positions-count={positions.length}>
      ({positions.length})
    </span>
  </div>

  <ul class="flex flex-col gap-3 md:hidden">
    {positions.map((position) => (
      <li class="flex min-w-0 flex-col gap-2 rounded-lg border p-4" data-position-card={position.id}>
        <div class="flex min-w-0 items-start justify-between gap-2">
          <a
            href={`/dashboard/positions/${position.id}`}
            class="min-w-0 font-semibold break-words underline underline-offset-4 hover:text-primary"
          >
            {position.instrument}
          </a>
          {closed && <Badge variant="secondary">Closed</Badge>}
        </div>
        <PositionResult
          opening_commission={position.opening_commission}
          closing_commission={position.closing_commission}
          buy_price={position.buy_price}
          quantity={position.quantity}
          current_price={position.current_price}
          price_date={position.price_date}
          sell_price={position.sell_price}
          sell_date={position.sell_date}
        />
        <PriceContext valuation={position.valuation} variant="compact" />
        <div class="flex min-w-0 flex-wrap items-center gap-2 text-sm">
          <Badge variant="secondary" className="max-w-full whitespace-normal break-words">
            {position.category_name}
          </Badge>
          {showWallet && (
            <a
              href={`/dashboard/wallets/${position.wallet_id}`}
              class="text-muted-foreground underline underline-offset-4 hover:text-primary"
            >
              {position.wallet_name}
            </a>
          )}
        </div>
        <DeletePositionControl id={position.id} instrument={position.instrument} />
      </li>
    ))}
  </ul>

  <Table className="hidden md:table">
    <TableHeader>
      <TableRow className="hover:bg-transparent">
        <TableHead scope="col" className="text-muted-foreground">
          Instrument
        </TableHead>
        <TableHead scope="col" className="text-muted-foreground">
          Result
        </TableHead>
        <TableHead scope="col" className="text-muted-foreground">
          Category
        </TableHead>
        {showWallet && (
          <TableHead scope="col" className="text-muted-foreground">
            Wallet
          </TableHead>
        )}
        <TableHead scope="col" className="text-muted-foreground">
          Buy date
        </TableHead>
        <TableHead scope="col" className="text-right text-muted-foreground">
          Buy price
        </TableHead>
        <TableHead scope="col" className="text-right text-muted-foreground">
          Quantity
        </TableHead>
        <TableHead scope="col" className="text-muted-foreground">
          Broker
        </TableHead>
        <TableHead scope="col">
          <span class="sr-only">Actions</span>
        </TableHead>
      </TableRow>
    </TableHeader>
    <TableBody>
      {positions.map((position) => (
        <TableRow>
          <TableCell className="font-semibold">
            <a href={`/dashboard/positions/${position.id}`} class="underline underline-offset-4 hover:text-primary">
              {position.instrument}
            </a>
            {closed && (
              <Badge variant="secondary" className="ml-2">
                Closed
              </Badge>
            )}
          </TableCell>
          <TableCell>
            <PositionResult
              opening_commission={position.opening_commission}
              closing_commission={position.closing_commission}
              buy_price={position.buy_price}
              quantity={position.quantity}
              current_price={position.current_price}
              price_date={position.price_date}
              sell_price={position.sell_price}
              sell_date={position.sell_date}
            />
            <div class="max-w-56 min-w-40 whitespace-normal">
              <PriceContext valuation={position.valuation} variant="compact" />
            </div>
          </TableCell>
          <TableCell>
            <Badge variant="secondary">{position.category_name}</Badge>
          </TableCell>
          {showWallet && (
            <TableCell>
              <a
                href={`/dashboard/wallets/${position.wallet_id}`}
                class="underline underline-offset-4 hover:text-primary"
              >
                {position.wallet_name}
              </a>
            </TableCell>
          )}
          <TableCell className="text-muted-foreground">{formatDate(position.buy_date)}</TableCell>
          <TableCell className="text-right tabular-nums">{formatNumber(position.buy_price)}</TableCell>
          <TableCell className="text-right text-muted-foreground tabular-nums">
            {position.quantity === null ? "—" : formatNumber(position.quantity)}
          </TableCell>
          <TableCell className="text-muted-foreground">{position.broker_label ?? "—"}</TableCell>
          <TableCell>
            <DeletePositionControl id={position.id} instrument={position.instrument} />
          </TableCell>
        </TableRow>
      ))}
    </TableBody>
  </Table>
</section>
