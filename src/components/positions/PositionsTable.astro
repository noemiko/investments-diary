---
import PositionsSection from "@/components/positions/PositionsSection.astro";
import type { PositionListItem } from "@/types";

interface Props {
  positions: PositionListItem[];
  showWallet?: boolean;
}

const { positions, showWallet = true } = Astro.props;

// Open and closed positions in separate sections, each keeping the service order; an empty section is omitted.
const open = positions.filter((position) => position.sell_date === null);
const closed = positions.filter((position) => position.sell_date !== null);
---

<div class="flex min-w-0 flex-col gap-8">
  {open.length > 0 && <PositionsSection kind="open" positions={open} showWallet={showWallet} />}
  {closed.length > 0 && <PositionsSection kind="closed" positions={closed} showWallet={showWallet} />}
</div>
