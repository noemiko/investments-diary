---
import { buttonVariants } from "@/components/ui/button";
import { MARKET_CURRENCIES, type MarketCurrency, type WalletFormErrors, type WalletFormValues } from "@/types";

// Plain form POST works without JavaScript and preserves submitted values on errors.

interface Props {
  values: WalletFormValues;
  errors: WalletFormErrors;
  submitLabel: string;
  confirmedCurrency?: MarketCurrency | null;
}

const { values, errors, submitLabel, confirmedCurrency } = Astro.props;

const inputClass =
  "h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive md:text-sm";
---

<form method="POST" class="flex flex-col gap-4" novalidate>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="flex flex-col gap-1">
      <label for="name" class="text-sm text-muted-foreground">
        Name
      </label>
      <input
        id="name"
        name="name"
        type="text"
        maxlength={60}
        placeholder="e.g. Retirement"
        value={values.name}
        aria-invalid={errors.name ? "true" : undefined}
        aria-describedby={errors.name ? "name-error" : undefined}
        class:list={inputClass}
      />
      {errors.name && (
        <p id="name-error" class="text-xs text-destructive">
          {errors.name}
        </p>
      )}
    </div>
    <div class="flex flex-col gap-1">
      <label for="starting_value" class="text-sm text-muted-foreground">
        Starting value
      </label>
      <input
        id="starting_value"
        name="starting_value"
        type="text"
        inputmode="decimal"
        placeholder="1000"
        value={values.starting_value}
        aria-invalid={errors.starting_value ? "true" : undefined}
        aria-describedby={errors.starting_value ? "starting_value-error" : undefined}
        class:list={inputClass}
      />
      {errors.starting_value && (
        <p id="starting_value-error" class="text-xs text-destructive">
          {errors.starting_value}
        </p>
      )}
    </div>
  </div>
  {confirmedCurrency ? (
    <p class="text-sm text-muted-foreground">Currency: {confirmedCurrency}. Confirmed currency cannot be changed.</p>
  ) : (
    <>
      <div class="flex flex-col gap-1">
        <label for="currency" class="text-sm text-muted-foreground">
          Currency
        </label>
        <select
          id="currency"
          name="currency"
          class:list={inputClass}
          aria-invalid={errors.currency ? "true" : undefined}
          aria-describedby={errors.currency ? "currency-error" : undefined}
        >
          <option value="" selected={values.currency === ""} class="bg-popover text-popover-foreground">
            Choose a currency
          </option>
          {MARKET_CURRENCIES.map((currency) => (
            <option value={currency} selected={values.currency === currency} class="bg-popover text-popover-foreground">
              {currency}
            </option>
          ))}
        </select>
        {errors.currency && (
          <p id="currency-error" class="text-xs text-destructive">
            {errors.currency}
          </p>
        )}
      </div>
      <div class="flex flex-col gap-1">
        <label class="flex items-start gap-2 text-sm">
          <input
            type="checkbox"
            name="currency_attested"
            checked={values.currency_attested === "on"}
            aria-invalid={errors.currency_attested ? "true" : undefined}
            aria-describedby={errors.currency_attested ? "currency_attested-error" : undefined}
          />
          I confirm that the starting value and every recorded buy, manual and sale price use this currency. It cannot
          be changed after confirmation.
        </label>
        {errors.currency_attested && (
          <p id="currency_attested-error" class="text-xs text-destructive">
            {errors.currency_attested}
          </p>
        )}
      </div>
    </>
  )}
  {errors.form && (
    <p role="alert" class="text-sm text-destructive">
      {errors.form}
    </p>
  )}
  <div>
    <button type="submit" class:list={buttonVariants()}>
      {submitLabel}
    </button>
  </div>
</form>
