---
import { formatAmount, formatPercent, formatSignedAmount } from "@/lib/format";
import { describeWalletResults, type WalletValueResult } from "@/lib/wallet";
import type { MarketCurrency } from "@/types";

interface Props {
  startingValue: string;
  result: WalletValueResult;
  currency: MarketCurrency;
}
const { startingValue, result, currency } = Astro.props;
---

<div class="flex flex-col gap-2" data-wallet-value={formatAmount(result.value)}>
  <p class="text-sm text-muted-foreground">Currency: {currency}</p>
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div>
      <dt class="text-sm text-muted-foreground">Starting value</dt>
      <dd class="tabular-nums">{formatAmount(startingValue)}</dd>
    </div>
    <div>
      <dt class="text-sm text-muted-foreground">Current value</dt>
      <dd class="font-semibold tabular-nums">{formatAmount(result.value)}</dd>
    </div>
    <div>
      <dt class="text-sm text-muted-foreground">Change</dt>
      <dd class="tabular-nums">
        {formatSignedAmount(result.change)}
        {result.changePercent !== null && <span> ({formatPercent(result.changePercent)})</span>}
      </dd>
    </div>
  </dl>
  <p class="text-sm text-muted-foreground">
    Live total from your latest recorded prices selected from saved manual entries and downloaded quotes
  </p>
  <dl class="grid grid-cols-2 gap-4">
    <div>
      <dt class="text-sm text-muted-foreground">Realised gain/loss</dt>
      <dd class="tabular-nums">{formatSignedAmount(result.realisedChange)}</dd>
    </div>
    <div>
      <dt class="text-sm text-muted-foreground">Open gain/loss</dt>
      <dd class="tabular-nums">{formatSignedAmount(result.openChange)}</dd>
    </div>
  </dl>
  <p class="text-sm text-muted-foreground">{describeWalletResults(result)}</p>
  {result.notCounted > 0 && (
    <p class="text-sm text-muted-foreground" data-wallet-not-counted={result.notCounted}>
      {result.notCounted} not counted (no quantity or no current price for an open position); paid opening commissions
      are included
    </p>
  )}
</div>
