{
  "name": "investments-diary",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "stop": "astro dev stop",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "smoke": "node scripts/testing/smoke.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "test:close-db": "node scripts/testing/database/test-close-database.mjs",
    "test:wallet-db": "node scripts/testing/database/test-wallet-database.mjs",
    "test:decimal-db": "node scripts/testing/database/test-decimal-database.mjs",
    "test:mutation": "node scripts/testing/mutation-financial.mjs",
    "verify": "astro sync && eslint . --no-warn-ignored && vitest run",
    "test:sentry-probe": "node scripts/observability/sentry-probe.mjs",
    "check:sentry-build": "node scripts/observability/check-sentry-build.mjs",
    "seed:demo": "node scripts/demo/seed-demo.mjs",
    "test:snapshots-db": "node scripts/testing/database/test-snapshots-database.mjs",
    "configure:wallet-cron": "node scripts/automation/configure-wallet-cron.mjs",
    "test:demo-db": "node --test scripts/demo/__tests__/demo-data.test.mjs",
    "test:wallet-cron": "node scripts/testing/database/test-wallet-cron.mjs",
    "probe:market-data": "node scripts/testing/market-data-probe.mjs",
    "test:market-prices-db": "node scripts/testing/database/test-market-prices-database.mjs && node scripts/testing/database/test-market-price-recovery.mjs && node scripts/testing/database/test-required-selection-migration.mjs",
    "test:grants-db": "node scripts/testing/database/test-policy-grants.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@eslint/config-helpers": "^0.7.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@sentry/astro": "11.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.99.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "yahoo-finance2": "4.0.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
