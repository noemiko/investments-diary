SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<your-local-publishable-key>
E2E_USERNAME=<your-local-test-email>
E2E_PASSWORD=<your-local-test-password>
# Empty = reporting disabled
PUBLIC_SENTRY_DSN=
SENTRY_PROJECT=
SENTRY_ORG=
SENTRY_AUTH_TOKEN=

# Optional portfolio transfer configuration. Missing values disable transfer, not normal diary use.
SUPABASE_SERVICE_ROLE_KEY=
# Stable identifier shared by deployments that should accept each other's original exports.
PORTFOLIO_DEPLOYMENT_ID=
# JSON: {"activeKeyId":"v1","keys":{"v1":"a-random-secret-of-at-least-32-bytes"}}
# Retain previous keys in this ring so old recovery exports remain verifiable.
PORTFOLIO_RECOVERY_KEYS=
